# Microkernel services build
# Produces services.a which gets linked with core.a into the final kernel.

COMPILER = clang
ASSEMBLER = nasm
AR = llvm-ar

TOPDIR ?= ${.CURDIR}/../../..

.include "${.CURDIR}/../include/config.mk"

# Debug builds keep the DWARF info around, release builds strip it by not
# asking for it in the first place.
.if defined(CONFIG_GENERIC_DBG) && ${CONFIG_GENERIC_DBG} == 1
DEBUG_CFLAGS = -g
.else
DEBUG_CFLAGS =
.endif

CFLAGS = --target=x86_64-elf -m64 ${DEBUG_CFLAGS} -c -ffreestanding -Wall -Werror -fcommon \
    -I../include/ \
    -I../services/net/lwip/include/ \
    -isystem ${TOPDIR}/target/usr/include \
    -fno-pie -fno-pic \
    -mcmodel=kernel \
    -mno-80387 \
    -mno-mmx \
    -mno-sse \
    -nostdlib \
    -mno-sse2 \
    -mno-red-zone -fno-stack-protector \
    -fno-stack-check \
    -fno-lto \
    -fno-omit-frame-pointer \
    -include ../include/config.h \
    -MMD -MP

ASFLAGS = -f elf64

C_SOURCES != find . -name '*.c' ! -name malloc.c ! -name printf.c | sed 's|^\./||' | sort
ASM_SOURCES != find . -name '*.asm' | sed 's|^\./||' | sort

C_OBJS = ${C_SOURCES:.c=.o}
ASM_OBJS = ${ASM_SOURCES:=.o}

TARGET = services.a

.PHONY: all clean

all: ${TARGET}

${TARGET}: ${C_OBJS} ${ASM_OBJS}
	${AR} rcs ${.TARGET} ${.ALLSRC}

# hmake has no %\.o: %\.c pattern rules, so generate one explicit rule per file.
.for src in ${C_SOURCES}
${src:R}.o: ${src}
	${COMPILER} ${CFLAGS} ${src} -o ${.TARGET}
.endfor

.for src in ${ASM_SOURCES}
${src}.o: ${src}
	${ASSEMBLER} ${ASFLAGS} -o ${.TARGET} ${src}
.endfor

# Header dependencies generated by clang's -MMD. Required because config.h is
# force-included into every translation unit.
.for dep in ${C_OBJS:.o=.d}
.-include "${dep}"
.endfor

clean:
	find . -name '*.o' -delete
	find . -name '*.d' -delete
	rm -f ${TARGET}