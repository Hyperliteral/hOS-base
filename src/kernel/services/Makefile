# Microkernel services build
# Produces services.a which gets linked with core.a into the final kernel.

COMPILER = clang
ASSEMBLER = nasm
AR = llvm-ar

include ../include/config.mk

# Debug builds keep the DWARF info around, release builds strip it by not
# asking for it in the first place.
ifeq ($(CONFIG_GENERIC_DBG),1)
    DEBUG_CFLAGS := -g
else
    DEBUG_CFLAGS :=
endif

# Updated target to standard 64-bit ELF
CFLAGS = --target=x86_64-elf -m64 $(DEBUG_CFLAGS) -c -ffreestanding -Wall -Werror -fcommon \
    -I../include/ \
    -I../services/net/lwip/include/ \
    -isystem ../../../target/usr/include \
    -fno-pie -fno-pic \
    -mcmodel=kernel \
    -mno-80387 \
    -mno-mmx \
    -mno-sse \
    -nostdlib \
    -mno-sse2 \
    -mno-red-zone -fno-stack-protector \
    -fno-stack-check \
    -fno-lto \
    -fno-omit-frame-pointer \
    -include ../include/config.h \
    -MMD -MP

# Updated output format for NASM assembly files to ELF64
ASFLAGS = -f elf64

C_SOURCES := $(shell find . -name '*.c' ! -name "malloc.c" ! -name "printf.c" -printf "%P\n")
ASM_SOURCES := $(shell find . -name '*.asm' -printf "%P\n")

C_OBJS = $(patsubst %.c,%.o,$(C_SOURCES))
ASM_OBJS = $(patsubst %.asm,%.asm.o,$(ASM_SOURCES))

TARGET = services.a

all: $(TARGET)

$(TARGET): $(C_OBJS) $(ASM_OBJS)
	$(AR) rcs $@ $^

%.o: %.c
	$(COMPILER) $(CFLAGS) $(subst .o,.c,$@) -o $@

%.asm.o: %.asm
	$(ASSEMBLER) $(ASFLAGS) -o $@ $(subst .asm.o,.asm,$@)

# Header dependencies, generated by clang's -MMD. Required because config.h is
# force-included into every translation unit.
-include $(C_OBJS:.o=.d)

clean:
	find . -name '*.o' -delete
	find . -name '*.d' -delete
	rm -f $(TARGET)

.PHONY: all clean