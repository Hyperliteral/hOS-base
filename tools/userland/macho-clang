#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
COMPILER=${MACHO_CLANG:-clang}

STARTUP="$ROOT/src/libs/macho/libmacho.a"
LIBC="$ROOT/src/libs/libc/libc.dylib"
LIBC_DIR="$ROOT/src/libs/libc"
# Headers live in $LIBC_DIR/include since the libc restructure (musl-compatible
# tree); $LIBC_DIR itself only holds the Makefile and build outputs now.
# gnu17, not c17: musl's <features.h> only enables the default BSD/POSIX API
# (strdup, strnlen, ...) when __STRICT_ANSI__ is unset.
LIBC_INC="$LIBC_DIR/include"

COMMON_FLAGS="--target=x86_64-apple-darwin -fuse-ld=lld -std=gnu17 -D_GNU_SOURCE -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-omit-frame-pointer -fno-lto -nostdlib -nostartfiles -isystem $LIBC_INC -isystem $ROOT/target/usr/include -Wl,-arch,x86_64 -Wl,-platform_version,macos,10.4,10.4 -Wl,-no_pie -Wl,-e,__start"
LINK_ONLY=0
USE_LIBC=1

for argument in "$@"; do
  case "$argument" in
    -c|-S|-E)
      LINK_ONLY=1
      ;;
    -nostdlib|-nodefaultlibs|-nostartfiles)
      USE_LIBC=0
      ;;
  esac
done

if [ "$LINK_ONLY" -eq 1 ]; then
  exec "$COMPILER" $COMMON_FLAGS "$@"
fi

if [ "$USE_LIBC" -eq 1 ]; then
  for library in "$STARTUP" "$LIBC"; do
    if [ ! -f "$library" ]; then
      printf '%s\n' "macho-clang: build $library first (bmake macho libc)" >&2
      exit 1
    fi
  done
  
  # Link with custom startup stub and libc
  exec "$COMPILER" $COMMON_FLAGS "$@" -L"$LIBC_DIR" -lc "$STARTUP"
else
  # User requested no standard libraries/startup files; omit custom libs
  exec "$COMPILER" $COMMON_FLAGS "$@"
fi