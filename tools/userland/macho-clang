#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
COMPILER=${MACHO_CLANG:-clang}
LIBRARY="$ROOT/src/libs/macho/libmacho.a"
COMMON_FLAGS="--target=x86_64-apple-darwin -fuse-ld=lld -std=gnu17 -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-omit-frame-pointer -fno-lto -nostdlib -nostartfiles -isystem $ROOT/src/libs/macho -isystem $ROOT/target/usr/include -Wl,-arch,x86_64 -Wl,-platform_version,macos,10.4,10.4 -Wl,-no_pie -Wl,-e,__start"
LINK_ONLY=0

for argument in "$@"; do
  case "$argument" in
        -c|-S|-E)
          LINK_ONLY=1
          ;;
  esac
done

if [ "$LINK_ONLY" -eq 1 ]; then
  exec "$COMPILER" $COMMON_FLAGS "$@"
fi

if [ ! -f "$LIBRARY" ]; then
  printf '%s\n' "macho-clang: build $LIBRARY first with make -C src/libs/macho" >&2
  exit 1
fi

exec "$COMPILER" $COMMON_FLAGS "$@" "$LIBRARY"
